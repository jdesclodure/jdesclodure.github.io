library(httr2)
library(writexl)
api_request <- function(
endpoint,
api_url = "https://data360api.worldbank.org/data360/",
method = "GET",
headers = NULL,
query = NULL,
body = NULL
) {
# Build the full request URL
req <- httr2::request(paste0(api_url, endpoint)) |>
httr2::req_method(method)  # Set HTTP method (GET, POST, etc.)
# Add headers if provided
if (!is.null(headers)) {
req <- req |> httr2::req_headers(!!!headers)
}
# Add query parameters if provided
if (!is.null(query)) {
req <- req |> httr2::req_url_query(!!!query)
}
# Add JSON body if provided (for POST requests)
if (!is.null(body)) {
req <- req |> httr2::req_body_json(body)
}
# Perform the request and parse the JSON response
req |>
httr2::req_perform() |>
httr2::resp_body_json()
}
