# variables to donwload
variables <- c(
"WB_WDI_SH_STA_BASS_ZS",    # Access to sewerage systems
"WB_WDI_SH_H2O_SMDW_ZS",    # Access to safe water
"WB_WDI_SH_H2O_BASW_ZS",    # Access to drinking water
"WB_CLEAR_SH_STA_WASH_P5",  # Mortality related to poor hygiene
"WB_WDI_SP_DYN_LE00_IN",    # Life expectancy
"WB_WDI_SP_POP_DPND_YG",    # Fraction of population non-independent (children/dependents)
"WB_SSGD_PCT_AGE_60_PLUS",  # Share of population aged 60+
# Health workforce density (3 indicators)
"WB_WDI_SH_MED_PHYS_ZS",    # Physicians (per 1,000 people)
"WB_WDI_SH_MED_NUMW_P3",    # Nurses and midwives (per 1,000 people)
"WB_WDI_SH_MED_CMHW_P3",    # Community health workers (per 1,000 people)
"WEF_TTDI_HOSPBED",         # Hospital bed density
# Health expenditures & poverty-related health indicators (multiple)
"UHC_SP_CATA",              # Population spending more than 10% or 25% of household consumption or income
# on out-of-pocket health care expenditure
"UHC_SCI",                  # Universal Health Coverage (UHC) service coverage index
"UHC_FH40",                 # Population facing financial hardship due to out-of-pocket health expenditure
"WB_WDI_SH_XPD_OOPC_CH_ZS", # Out-of-pocket expenditure (% of current health expenditure)
"WB_WDI_SH_XPD_CHEX_PP_CD", # Current health expenditure per capita, PPP (current international $)
"WB_WDI_SH_XPD_OOPC_CH_ZS", # Out-of-pocket expenditure (% of current health expenditure)
"WB_WDI_SH_XPD_GHED_GD_ZS", # Domestic general government health expenditure (% of GDP)
"WB_CCKP_PR",               # Precipitation
"WB_CCKP_TAS",              # Average temperature
"WB_CCKP_TASMIN",           # Average minimum temperature
"WB_CCKP_TASMAX",           # Average maximum temperature
"WB_SSGD_CIVIC_SPACE_IDX",  # Civic rights / freedom
"WB_WDI_EN_POP_DNST",       # Population density (inhabitants/km²)
"WB_WDI_SP_URB_TOTL_IN_ZS", # Urban population share
"WB_WDI_AG_LND_AGRI_ZS",    # Share of agricultural land
"FAO_CAHD_7008",            # Cost of animal proteins
"WB_WDI_NY_GDP_PCAP_CD",    # GDP per capita
"WB_WDI_SI_POV_GINI",       # GINI index
"WB_WDI_ST_INT_ARVL",       # Tourism (arrivals)
"WB_CLEAR_INFORM_GOV",      # Governance index
"WEF_TTDI_TTDI_E_15_02"     # Environmental quality – pollution
)
